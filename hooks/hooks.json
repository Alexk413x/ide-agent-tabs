{
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "set -- server SessionStart; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/server-hook.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-tabs\" sync-ides --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -- server SessionEnd; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/server-hook.ps1\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

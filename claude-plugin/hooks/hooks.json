{
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server-start.mjs", "SessionStart"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/sync-ides.mjs", "--hook"],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$IDE_AGENT_TABS_ID\" ] && [ \"$IDE_AGENT_TABS_ID\" != \"$IDE_AGENT_TABS_MOD\" ] || exit 0; set -- claude SessionStart; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server-start.mjs", "SessionEnd"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$IDE_AGENT_TABS_ID\" ] && [ \"$IDE_AGENT_TABS_ID\" != \"$IDE_AGENT_TABS_MOD\" ] || exit 0; set -- claude UserPromptSubmit; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$IDE_AGENT_TABS_ID\" ] && [ \"$IDE_AGENT_TABS_ID\" != \"$IDE_AGENT_TABS_MOD\" ] || exit 0; set -- claude PostToolUse; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$IDE_AGENT_TABS_ID\" ] && [ \"$IDE_AGENT_TABS_ID\" != \"$IDE_AGENT_TABS_MOD\" ] || exit 0; set -- claude PostToolUseFailure; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$IDE_AGENT_TABS_ID\" ] && [ \"$IDE_AGENT_TABS_ID\" != \"$IDE_AGENT_TABS_MOD\" ] || exit 0; set -- claude Notification; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$IDE_AGENT_TABS_ID\" ] && [ \"$IDE_AGENT_TABS_ID\" != \"$IDE_AGENT_TABS_MOD\" ] || exit 0; set -- claude Stop; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$IDE_AGENT_TABS_ID\" ] && [ \"$IDE_AGENT_TABS_ID\" != \"$IDE_AGENT_TABS_MOD\" ] || exit 0; set -- claude StopFailure; . \"${CLAUDE_PLUGIN_ROOT}/mcp/launch/agent-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

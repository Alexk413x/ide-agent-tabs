{
  "name": "ide-agent-tabs",
  "displayName": "Agent Tabs",
  "icon": "resources/icon.png",
  "description": "Open Claude Code, Codex, Gemini CLI, Copilot CLI and other agent CLIs in editor tabs, from a button or from another agent.",
  "version": "0.1.11",
  "publisher": "alexk413x",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexk413x/ide-agent-tabs.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agent",
    "claude",
    "codex",
    "gemini",
    "copilot",
    "terminal"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": {
      "title": "Agent Tabs",
      "properties": {
        "ideAgentTabs.defaultAgent": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "codex",
            "gemini",
            "copilot",
            ""
          ],
          "enumItemLabels": [
            "Claude Code",
            "Codex",
            "Gemini CLI",
            "Copilot CLI",
            "Shared"
          ],
          "enumDescriptions": [
            "Open Claude Code.",
            "Open Codex.",
            "Open Gemini CLI.",
            "Open Copilot CLI.",
            "Open the defaultAgent in ~/.ide-agent-tabs/config.json, which other IDEs share. Use it for a custom agent from agents.json."
          ],
          "description": "The agent that the New Agent Tab button, the status bar item and startup open."
        },
        "ideAgentTabs.openOnStartup": {
          "type": "string",
          "default": "claudeFolder",
          "enum": [
            "claudeFolder",
            "always",
            "never"
          ],
          "enumItemLabels": [
            "When the project has a .claude folder",
            "Always",
            "Never"
          ],
          "enumDescriptions": [
            "Open the default agent when a window or added folder has a .claude folder at its root.",
            "Open the default agent when a window with a folder opens, or a folder is added.",
            "Don't open an agent tab on startup."
          ],
          "description": "When to open the default agent in an editor tab without a click."
        }
      }
    },
    "commands": [
      {
        "command": "ideAgentTabs.newTab",
        "title": "New Agent Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agentTab_new.svg",
          "dark": "resources/icons/agentTab_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.newTabWith",
        "title": "New Agent Tab With…",
        "category": "Agent Tabs",
        "icon": "$(chevron-down)"
      },
      {
        "command": "ideAgentTabs.newTab.claude",
        "title": "New Claude Code Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/claude_new.svg",
          "dark": "resources/icons/agents/claude_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.newTab.codex",
        "title": "New Codex Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/codex_new.svg",
          "dark": "resources/icons/agents/codex_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.newTab.gemini",
        "title": "New Gemini CLI Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/gemini_new.svg",
          "dark": "resources/icons/agents/gemini_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.newTab.copilot",
        "title": "New Copilot CLI Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/copilot_new.svg",
          "dark": "resources/icons/agents/copilot_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.newTab.other",
        "title": "New Agent Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agentTab_new.svg",
          "dark": "resources/icons/agentTab_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.open.claude",
        "title": "Claude Code",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.open.codex",
        "title": "Codex",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.open.gemini",
        "title": "Gemini CLI",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.open.copilot",
        "title": "Copilot CLI",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.openSettings",
        "title": "Settings",
        "category": "Agent Tabs",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ideAgentTabs.newTab.claude",
          "when": "ideAgentTabs.buttonAgent == claude",
          "group": "navigation@100"
        },
        {
          "command": "ideAgentTabs.newTab.codex",
          "when": "ideAgentTabs.buttonAgent == codex",
          "group": "navigation@100"
        },
        {
          "command": "ideAgentTabs.newTab.gemini",
          "when": "ideAgentTabs.buttonAgent == gemini",
          "group": "navigation@100"
        },
        {
          "command": "ideAgentTabs.newTab.copilot",
          "when": "ideAgentTabs.buttonAgent == copilot",
          "group": "navigation@100"
        },
        {
          "command": "ideAgentTabs.newTab.other",
          "when": "ideAgentTabs.buttonAgent == other",
          "group": "navigation@100"
        },
        {
          "submenu": "ideAgentTabs.agents",
          "group": "navigation@101"
        }
      ],
      "commandPalette": [
        {
          "command": "ideAgentTabs.newTab.claude",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.codex",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.gemini",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.copilot",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.other",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.claude",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.codex",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.gemini",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.copilot",
          "when": "false"
        }
      ],
      "ideAgentTabs.agents": [
        {
          "command": "ideAgentTabs.open.claude",
          "when": "ideAgentTabs.installed.claude",
          "group": "1_agents@0"
        },
        {
          "command": "ideAgentTabs.open.codex",
          "when": "ideAgentTabs.installed.codex",
          "group": "1_agents@1"
        },
        {
          "command": "ideAgentTabs.open.gemini",
          "when": "ideAgentTabs.installed.gemini",
          "group": "1_agents@2"
        },
        {
          "command": "ideAgentTabs.open.copilot",
          "when": "ideAgentTabs.installed.copilot",
          "group": "1_agents@3"
        },
        {
          "command": "ideAgentTabs.newTabWith",
          "when": "ideAgentTabs.customInstalled",
          "group": "2_more"
        },
        {
          "command": "ideAgentTabs.openSettings",
          "group": "3_settings"
        }
      ]
    },
    "submenus": [
      {
        "id": "ideAgentTabs.agents",
        "label": "New Agent Tab With…",
        "icon": {
          "light": "resources/icons/agentTab_menu.svg",
          "dark": "resources/icons/agentTab_menu_dark.svg"
        }
      }
    ],
    "icons": {
      "agent-tabs-new": {
        "description": "New agent tab",
        "default": {
          "fontPath": "resources/agent-tabs-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"out/test/**/*.test.js\"",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.0"
  }
}

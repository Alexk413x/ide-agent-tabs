{
  "name": "ide-agent-tabs",
  "displayName": "Agent Tabs",
  "icon": "resources/icon.png",
  "description": "Open Claude Code, Codex, Antigravity CLI, Copilot CLI, Gemini CLI and other agent CLIs in editor tabs, from a button or from another agent.",
  "version": "0.1.21",
  "publisher": "alexk413x",
  "license": "LicenseRef-Proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexk413x/ide-agent-tabs.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agent",
    "claude",
    "codex",
    "agy",
    "copilot",
    "gemini",
    "terminal"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "ideAgentTabs.preferredTerminal",
        "ideAgentTabs.windowsShell"
      ]
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Agent Tabs",
        "properties": {
          "ideAgentTabs.defaultAgent": {
            "type": "string",
            "default": "claude",
            "enum": [
              "claude",
              "codex",
              "agy",
              "copilot",
              "gemini"
            ],
            "enumItemLabels": [
              "Claude Code",
              "Codex",
              "Antigravity CLI",
              "Copilot CLI",
              "Gemini CLI"
            ],
            "enumDescriptions": [
              "Claude Code.",
              "Codex.",
              "Antigravity CLI.",
              "Copilot CLI.",
              "Gemini CLI."
            ],
            "description": "The agent that the editor title button, the status bar item and startup open.",
            "order": 1
          },
          "ideAgentTabs.openOnStartup": {
            "type": "string",
            "default": "claudeFolder",
            "enum": [
              "claudeFolder",
              "always",
              "never"
            ],
            "enumItemLabels": [
              "When the project has a .claude folder",
              "Always",
              "Never"
            ],
            "enumDescriptions": [
              "Open the default agent when a window or added folder has a .claude folder at its root.",
              "Open the default agent when a window with a folder opens, or a folder is added.",
              "Don't open an agent tab on startup."
            ],
            "description": "When to open the default agent in an editor tab without a click.",
            "order": 2
          }
        },
        "order": 1
      },
      {
        "title": "Agent Tabs: IDE tabs",
        "order": 2,
        "properties": {
          "ideAgentTabs.openNewTabsIn": {
            "type": "string",
            "scope": "machine",
            "default": "project",
            "enum": [
              "project",
              "caller"
            ],
            "enumItemLabels": [
              "IDE that has the project open",
              "IDE the request came from"
            ],
            "enumDescriptions": [
              "Open the tab in the IDE that has the project open, then in the IDE the request came from, then in the most recent IDE, then in a terminal.",
              "Open the tab in the IDE the request came from, even if another IDE has the project. Match the project only when the request doesn't come from an IDE. A request from a terminal tab opens the new tab in that terminal window."
            ],
            "description": "Where a new agent tab opens when no IDE or terminal is named.",
            "order": 1
          }
        }
      },
      {
        "title": "Agent Tabs: Terminal tabs",
        "order": 3,
        "properties": {
          "ideAgentTabs.preferredTerminal": {
            "type": "string",
            "scope": "machine",
            "default": "auto",
            "markdownDescription": "Terminal for agent tabs when no IDE is running or a terminal is asked for. `auto` picks the first installed terminal. [Choose…](command:ideAgentTabs.choosePreferredTerminal)",
            "order": 1
          },
          "ideAgentTabs.windowsShell": {
            "type": "string",
            "scope": "machine",
            "default": "auto",
            "markdownDescription": "PowerShell that runs agent tabs in a terminal. Windows only. `auto` picks the newest PowerShell 7, else Windows PowerShell 5.1. [Choose…](command:ideAgentTabs.chooseWindowsShell)",
            "order": 2
          },
          "ideAgentTabs.terminalWindow": {
            "type": "string",
            "scope": "machine",
            "default": "last",
            "enum": [
              "last",
              "dedicated"
            ],
            "enumItemLabels": [
              "Use my last window",
              "A dedicated Agent Tabs window"
            ],
            "enumDescriptions": [
              "Open terminal tabs in the terminal window you used last.",
              "Open terminal tabs in a window kept for Agent Tabs."
            ],
            "description": "Whether terminal tabs join your last window or a window kept for Agent Tabs.",
            "order": 3
          }
        }
      }
    ],
    "commands": [
      {
        "command": "ideAgentTabs.newTab",
        "title": "New Agent Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agentTab_new.svg",
          "dark": "resources/icons/agentTab_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.newTabWith",
        "title": "New Agent Tab With…",
        "category": "Agent Tabs",
        "icon": "$(chevron-down)"
      },
      {
        "command": "ideAgentTabs.newTab.claude",
        "title": "New Claude Code Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/claude_new.svg",
          "dark": "resources/icons/agents/claude_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.open.claude",
        "title": "Claude Code",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.newTab.codex",
        "title": "New Codex Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/codex_new.svg",
          "dark": "resources/icons/agents/codex_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.open.codex",
        "title": "Codex",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.newTab.agy",
        "title": "New Antigravity CLI Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/agy_new.svg",
          "dark": "resources/icons/agents/agy_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.newTab.other",
        "title": "New Agent Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agentTab_new.svg",
          "dark": "resources/icons/agentTab_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.open.agy",
        "title": "Antigravity CLI",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.newTab.copilot",
        "title": "New Copilot CLI Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/copilot_new.svg",
          "dark": "resources/icons/agents/copilot_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.open.copilot",
        "title": "Copilot CLI",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.newTab.gemini",
        "title": "New Gemini CLI Tab",
        "category": "Agent Tabs",
        "icon": {
          "light": "resources/icons/agents/gemini_new.svg",
          "dark": "resources/icons/agents/gemini_new_dark.svg"
        }
      },
      {
        "command": "ideAgentTabs.open.gemini",
        "title": "Gemini CLI",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.choosePreferredTerminal",
        "title": "Choose Preferred Terminal…",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.chooseWindowsShell",
        "title": "Choose Windows Shell…",
        "category": "Agent Tabs"
      },
      {
        "command": "ideAgentTabs.openSettings",
        "title": "Settings",
        "category": "Agent Tabs",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "ideAgentTabs.newTab",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "ideAgentTabs.newTab.claude",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "ideAgentTabs.buttonAgent == claude"
      },
      {
        "command": "ideAgentTabs.newTab.codex",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "ideAgentTabs.buttonAgent == codex"
      },
      {
        "command": "ideAgentTabs.newTab.agy",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "ideAgentTabs.buttonAgent == agy"
      },
      {
        "command": "ideAgentTabs.newTab.copilot",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "ideAgentTabs.buttonAgent == copilot"
      },
      {
        "command": "ideAgentTabs.newTab.gemini",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "ideAgentTabs.buttonAgent == gemini"
      },
      {
        "command": "ideAgentTabs.newTab.other",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "ideAgentTabs.buttonAgent == other"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ideAgentTabs.newTab.claude",
          "when": "ideAgentTabs.buttonAgent == claude",
          "group": "navigation@-0.2"
        },
        {
          "command": "ideAgentTabs.newTab.codex",
          "when": "ideAgentTabs.buttonAgent == codex",
          "group": "navigation@-0.2"
        },
        {
          "command": "ideAgentTabs.newTab.agy",
          "when": "ideAgentTabs.buttonAgent == agy",
          "group": "navigation@-0.2"
        },
        {
          "command": "ideAgentTabs.newTab.copilot",
          "when": "ideAgentTabs.buttonAgent == copilot",
          "group": "navigation@-0.2"
        },
        {
          "command": "ideAgentTabs.newTab.gemini",
          "when": "ideAgentTabs.buttonAgent == gemini",
          "group": "navigation@-0.2"
        },
        {
          "command": "ideAgentTabs.newTab.other",
          "when": "ideAgentTabs.buttonAgent == other",
          "group": "navigation@-0.2"
        },
        {
          "submenu": "ideAgentTabs.agents",
          "group": "navigation@-0.1"
        }
      ],
      "commandPalette": [
        {
          "command": "ideAgentTabs.newTab.claude",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.claude",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.codex",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.codex",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.agy",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.other",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.agy",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.copilot",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.copilot",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.newTab.gemini",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.open.gemini",
          "when": "false"
        },
        {
          "command": "ideAgentTabs.chooseWindowsShell",
          "when": "isWindows"
        }
      ],
      "ideAgentTabs.agents": [
        {
          "command": "ideAgentTabs.open.claude",
          "when": "ideAgentTabs.installed.claude",
          "group": "1_agents@0"
        },
        {
          "command": "ideAgentTabs.open.codex",
          "when": "ideAgentTabs.installed.codex",
          "group": "1_agents@1"
        },
        {
          "command": "ideAgentTabs.open.agy",
          "when": "ideAgentTabs.installed.agy",
          "group": "1_agents@2"
        },
        {
          "command": "ideAgentTabs.open.copilot",
          "when": "ideAgentTabs.installed.copilot",
          "group": "1_agents@3"
        },
        {
          "command": "ideAgentTabs.open.gemini",
          "when": "ideAgentTabs.installed.gemini",
          "group": "1_agents@4"
        },
        {
          "command": "ideAgentTabs.newTabWith",
          "when": "ideAgentTabs.customInstalled",
          "group": "2_more"
        },
        {
          "command": "ideAgentTabs.openSettings",
          "group": "3_settings"
        }
      ]
    },
    "submenus": [
      {
        "id": "ideAgentTabs.agents",
        "label": "New Agent Tab With…",
        "icon": {
          "light": "resources/icons/agentTab_menu.svg",
          "dark": "resources/icons/agentTab_menu_dark.svg"
        }
      }
    ],
    "icons": {
      "agent-tabs": {
        "description": "Agent tab",
        "default": {
          "fontPath": "resources/agent-tabs-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"out/test/**/*.test.js\"",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.0"
  }
}

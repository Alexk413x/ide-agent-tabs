{
  "name": "ide-agent-tabs",
  "displayName": "Agent Tabs",
  "icon": "resources/icon.png",
  "description": "Open Claude Code, Codex, Antigravity CLI, Copilot CLI, Gemini CLI and other agent CLIs in editor tabs, from a button or from another agent.",
  "version": "0.1.26",
  "publisher": "alexk413x",
  "license": "LicenseRef-Proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexk413x/ide-agent-tabs.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agent",
    "claude",
    "codex",
    "agy",
    "copilot",
    "gemini",
    "terminal"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "ideAgentTabs.preferredTerminal",
        "ideAgentTabs.windowsShell",
        "ideAgentTabs.launchVia"
      ]
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Agent Tabs",
        "properties": {
          "ideAgentTabs.defaultAgent": {
            "type": "string",
            "default": "claude",
            "enum": [
              "claude",
              "codex",
              "agy",
              "copilot",
              "gemini",
              "grok",
              "pi",
              "hermes",
              "opencode",
              "qwen",
              "goose",
              "codex-local"
            ],
            "enumItemLabels": [
              "Claude Code",
              "Codex",
              "Antigravity CLI",
              "Copilot CLI",
              "Gemini CLI",
              "Grok Build",
              "Pi",
              "Hermes",
              "OpenCode",
              "Qwen Code",
              "Goose",
              "Codex (local)"
            ],
            "enumDescriptions": [
              "Claude Code.",
              "Codex.",
              "Antigravity CLI.",
              "Copilot CLI.",
              "Gemini CLI.",
              "Grok Build.",
              "Pi.",
              "Hermes.",
              "OpenCode.",
              "Qwen Code.",
              "Goose.",
              "Codex (local)."
            ],
            "description": "The agent that the editor title button, the status bar item and startup open.",
            "order": 1
          },
          "ideAgentTabs.openOnStartup": {
            "type": "string",
            "default": "claudeFolder",
            "enum": [
              "claudeFolder",
              "always",
              "never"
            ],
            "enumItemLabels": [
              "When the project has a .claude folder",
              "Always",
              "Never"
            ],
            "enumDescriptions": [
              "Open the default agent when a window or added folder has a .claude folder at its root.",
              "Open the default agent when a window with a folder opens, or a folder is added.",
              "Don't open an agent tab on startup."
            ],
            "description": "When to open the default agent in an editor tab without a click.",
            "order": 2
          },
          "ideAgentTabs.launchVia": {
            "type": "string",
            "scope": "machine",
            "default": "direct",
            "enum": [
              "direct",
              "ori"
            ],
            "enumItemLabels": [
              "Directly",
              "Through Ori"
            ],
            "enumDescriptions": [
              "Start each agent with its own command.",
              "Start supported agents with `ori <agent>`."
            ],
            "markdownDescription": "Launch through OpenRouter (Ori). Start supported agents with `ori <agent>`, which bills model usage through OpenRouter. Needs Ori (`ori`) installed.",
            "order": 3
          },
          "ideAgentTabs.closeAfterHandoff": {
            "type": "boolean",
            "scope": "machine",
            "default": true,
            "markdownDescription": "Close the old tab after a handoff. After a handoff, the new session closes the old tab once both sides confirm. Off leaves the old tab open, marked as handed off.",
            "order": 4
          },
          "ideAgentTabs.claudeMod": {
            "type": "string",
            "scope": "machine",
            "default": "on",
            "enum": [
              "on",
              "off"
            ],
            "enumItemLabels": [
              "On",
              "Off"
            ],
            "enumDescriptions": [
              "Claude Code sessions message other agents with SendMessage and ListAgents, and get their messages in-process.",
              "Claude Code sessions use the Agent Tabs hooks, wake lines and messaging tools, as in 0.6.0."
            ],
            "markdownDescription": "Use the Claude Code mod (in-process messaging). Takes effect in Claude Code sessions that start after the change.",
            "order": 5
          }
        },
        "order": 1
      },
      {
        "title": "Agent Tabs: IDE tabs",
        "order": 2,
        "properties": {
          "ideAgentTabs.openNewTabsIn": {
            "type": "string",
            "scope": "machine",
            "default": "project",
            "enum": [
              "project",
              "caller"
            ],
            "enumItemLabels": [
              "IDE that has the project open",
              "IDE the request came from"
            ],
            "enumDescriptions": [
              "Open the tab in the IDE that has the project open, then in the IDE the request came from, then in the most recent IDE, then in a terminal.",
              "Open the tab in the IDE the request came from, even if another IDE has the project. Match the project only when the request doesn't come from an IDE. A request from a terminal tab opens the new tab in that terminal window."
            ],
            "description": "Where a new agent tab opens when no IDE or terminal is named.",
            "order": 1
          },
          "ideAgentTabs.focusNewTabs": {
            "type": "string",
            "scope": "machine",
            "default": "auto",
            "enum": [
              "auto",
              "always",
              "never"
            ],
            "enumItemLabels": [
              "When you asked for the tab",
              "Always",
              "Never"
            ],
            "enumDescriptions": [
              "Open an agent's tab behind the current one, and bring it to the front when the agent says you asked for it.",
              "Bring every new agent tab to the front, unless the agent asks to open it behind.",
              "Open new agent tabs behind the current one, unless the agent asks to bring it to the front."
            ],
            "markdownDescription": "Bring new agent tabs to the front. Applies to tabs that agents open with `open_tab` or a handoff; the New Agent Tab button always brings its tab to the front. Some terminals can't open a tab behind the current one.",
            "order": 2
          }
        }
      },
      {
        "title": "Agent Tabs: Terminal tabs",
        "order": 3,
        "properties": {
          "ideAgentTabs.preferredTerminal": {
            "type": "string",
            "scope": "machine",
            "default": "auto",
            "markdownDescription": "Terminal for agent tabs when no IDE is running or a terminal is asked for. `auto` picks the first installed terminal. [Choose…](command:ideAgentTabs.choosePreferredTerminal)",
            "order": 1
          },
          "ideAgentTabs.windowsShell": {
            "type": "string",
            "scope": "machine",
            "default": "auto",
            "markdownDescription": "PowerShell that runs agent tabs in a terminal. Windows only. `auto` picks the newest PowerShell 7, else Windows PowerShell 5.1. [Choose…](command:ideAgentTabs.chooseWindowsShell)",
            "order": 2
          },
          "ideAgentTabs.terminalWindow": {
            "type": "string",
            "scope": "machine",
            "default": "last",
            "enum": [
              "last",
              "dedicated"
            ],
            "enumItemLabels": [
              "Use my last window",
              "A dedicated Agent Tabs window"
            ],
            "enumDescriptions": [
              "Open terminal tabs in the terminal window you used last.",
              "Open terminal tabs in a window kept for Agent Tabs."
            ],
            "description": "Whether terminal tabs join your last window or a window kept for Agent Tabs.",
            "order": 3
          }
        }
      }
    ],
